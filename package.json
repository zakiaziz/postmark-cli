{
  "name": "@zakiaziz/postmark-cli",
  "version": "0.1.0",
  "description": "A complete command line interface for the Postmark API.",
  "type": "module",
  "bin": {
    "postmark": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build",
    "dev": "bun --watch src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "postmark",
    "cli",
    "email",
    "api"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "bun@1.3.11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakiaziz/postmark-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
